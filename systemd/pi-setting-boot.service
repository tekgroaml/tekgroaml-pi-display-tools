[Unit]
Description=Restore identity-bound Pi screen compatibility profiles
After=systemd-udev-trigger.service sys-kernel-debug.mount
Wants=sys-kernel-debug.mount
Before=display-manager.service

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/pi-setting/src
ExecStart=/usr/bin/python3 -m pi_setting.boot
TimeoutStartSec=45

[Install]
WantedBy=graphical.target
